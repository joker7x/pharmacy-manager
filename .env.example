# متغيرات بيئة تطبيق صيدليتي — انسخ الملف لـ .env ثم املأ القيم.
# .env غير متابع في git، فمفاتيح Supabase هتفضل على جهازك.

# ── النسخ الاحتياطي السحابي (Supabase) ─────────────────────────────
# من Supabase Studio ← Project Settings ← API Keys
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# اسم الجدول كما أنشأته في supabase/pharmacy-backups.sql
EXPO_PUBLIC_SUPABASE_TABLE=pharmacy_backups

# ── سيرفر الـ API (tRPC) ───────────────────────────────────────────
# على المتصفح المحلي تركه فاضي؛ على الموبايل حط IP الجهاز في الشبكة مثل http://192.168.1.20:3000
# API_BASE_URL=http://192.168.1.20:3000

# ── قاعدة بيانات العاملين والكتالوج (MySQL) ─────────────────────────
# DATABASE_URL=mysql://user:password@localhost:3306/saydalty
